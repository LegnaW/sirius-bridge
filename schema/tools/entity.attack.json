    "uuid": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uuid"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "radius": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 64,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Radius"
    },
    "count": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Count",
      "type": "integer"
    },
    "interval_ms": {
      "default": 600,
      "maximum": 5000,
      "minimum": 0,
      "title": "Interval Ms",
      "type": "integer"
    },
    "wait_cooldown": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wait Cooldown"
    }
  },
  "title": "EntityAttackParams",
  "type": "object"
}
