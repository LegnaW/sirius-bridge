{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "block.get({x,y,z})。协议 1.10 的单格读取原语。返回 registry id、完整方块状态和 ok/unloaded/out_of_world；真实空气与未加载不再混为一谈。max_y 为包含在内的建筑上界。",
  "properties": {
    "x": {
      "maximum": 30000000,
      "minimum": -30000000,
      "title": "X",
      "type": "integer"
    },
    "y": {
      "maximum": 30000000,
      "minimum": -30000000,
      "title": "Y",
      "type": "integer"
    },
    "z": {
      "maximum": 30000000,
      "minimum": -30000000,
      "title": "Z",
      "type": "integer"
    }
  },
  "required": [
    "x",
    "y",
    "z"
  ],
  "title": "BlockGetParams",
  "type": "object"
}
